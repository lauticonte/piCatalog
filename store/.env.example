# ---------------------------------------------------------------------------
# API del admin
# ---------------------------------------------------------------------------
# Solo la usa el checkout del carrito (app/(routes)/cart/components/summary.tsx).
# Formato: <origen-del-admin>/api/<storeId>
#
# Admin local:
NEXT_PUBLIC_API_URL=http://localhost:3000/api/65ec0a796702c9c0e4c0895f
# Producción:
# NEXT_PUBLIC_API_URL=https://admin.mhgarage.ar/api/65ec0a796702c9c0e4c0895f
#
# OJO: el resto de las llamadas (productos, categorías, marcas, colores, billboards)
# NO leen esta variable: tienen la URL de producción hardcodeada en actions/*.tsx.
# Es decir, el store local lee datos del admin de producción salvo que parametrices
# esos archivos.

# ---------------------------------------------------------------------------
# Origen del admin para los combos (solo server-side)
# ---------------------------------------------------------------------------
# Si no se define, los combos se leen del admin de producción.
# Para desarrollo local, apuntalo a tu admin:
ADMIN_API_URL=http://localhost:3000/api/65ec0a796702c9c0e4c0895f
