# ---------------------------------------------------------------------------
# API del admin (de donde salen productos, categorías, marcas, combos y menú)
# ---------------------------------------------------------------------------
# Solo server-side. Formato: <origen-del-admin>/api/<storeId>
# Si no se define, se usa el admin de producción.
ADMIN_API_URL=http://localhost:3000/api/65ec0a796702c9c0e4c0895f

# Mismo valor, pero leído desde el navegador: el botón "Consultar" avisa al admin
# antes de abrir WhatsApp. Si no se define, se usa el admin de producción.
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:3000/api/65ec0a796702c9c0e4c0895f

# ---------------------------------------------------------------------------
# PostHog (visitas y Web Vitals) - opcional
# ---------------------------------------------------------------------------
# Sin esta clave la tienda no manda analítica.
NEXT_PUBLIC_POSTHOG_KEY=<phc_...>
