# ---------------------------------------------------------------------------
# Base de datos (MongoDB)
# ---------------------------------------------------------------------------
# Prisma con MongoDB requiere un replica set: usá Atlas (o `mongodb://localhost:27017/?replicaSet=rs0`
# si levantaste uno local a mano). Un `mongod` suelto NO funciona.
DATABASE_URL="mongodb+srv://usuario:password@cluster.mongodb.net/picatalog?retryWrites=true&w=majority"

# ---------------------------------------------------------------------------
# Clerk (autenticación) - https://dashboard.clerk.com
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=<tu-publishable-key-de-clerk>
CLERK_SECRET_KEY=<tu-secret-key-de-clerk>
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ---------------------------------------------------------------------------
# Cloudinary (subida de imágenes, vía next-cloudinary)
# ---------------------------------------------------------------------------
# El upload preset está hardcodeado como 'nhgarage' en components/ui/image-upload.tsx.
# Tiene que existir como preset *unsigned* en tu cuenta (o cambiá el nombre en ese archivo).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=tu_cloud_name

# ---------------------------------------------------------------------------
# Stripe (checkout)
# ---------------------------------------------------------------------------
STRIPE_API_KEY=<tu-secret-key-de-stripe>
# Para local: `stripe listen --forward-to localhost:3000/api/webhook` te da este valor.
STRIPE_WEBHOOK_SECRET=<tu-webhook-secret-de-stripe>

# ---------------------------------------------------------------------------
# URL del store, usada para los redirects de éxito/cancelación del checkout
# ---------------------------------------------------------------------------
FRONTEND_STORE_URL=http://localhost:3001
